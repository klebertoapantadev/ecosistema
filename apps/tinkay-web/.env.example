NEXT_PUBLIC_SUPABASE_URL=https://oaybbpdxhlxjbpwnoymy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vC-t-FcOQ2Q5_XkTCcPKdQ_bveIh5YS

# Agente "Mía" en ARIA (chat de la tienda, app/api/chat). Solo servidor: nunca
# con prefijo NEXT_PUBLIC_. Sin estas tres variables el chat responde con sus
# reglas locales de respaldo. El prompt de Mía se edita en el panel de ARIA.
ARIA_BASE=
ARIA_AGENT_ID=
ARIA_AGENT_KEY=
