# Copiar a .env.local (ignorado por git) y rellenar con valores reales.
# Nunca commitear valores reales. En Vercel, configurar como Environment
# Variables del proyecto tranqi-web (no del proyecto viejo).

ARIA_BASE=https://logs-testing.mysatcomla.com/agentes
ARIA_AGENT_ID=
ARIA_AGENT_KEY=

# Proyecto Supabase "ecosistema" (oaybbpdxhlxjbpwnoymy) -- ver
# gobernanza/arquitectura/inventario-supabase.md. URL y publishable key son
# publicas por diseno (la seguridad real es RLS, no el secreto de esta clave).
NEXT_PUBLIC_SUPABASE_URL=https://auth.tranqi24.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vC-t-FcOQ2Q5_XkTCcPKdQ_bveIh5YS

# SMTP propio de tranqi (Zoho Mail, info@tranqi24.com) -- usado por
# @eco/notificaciones para el OTP de registro. Nunca NEXT_PUBLIC_*: server-only
# (ver gobernanza/politicas/gestion-credenciales.md §3).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@tranqi24.com
SMTP_PASS=
SMTP_FROM_NOMBRE=tranqi
