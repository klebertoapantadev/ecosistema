# Copiar a .env.local (ignorado por git) y rellenar con valores reales.
# Nunca commitear valores reales. En Vercel, configurar como Environment
# Variables del proyecto tranqi-web (no del proyecto viejo).

# ── Buddie de la landing publica (PLT-004, sin sesion ni herramientas) ──
ARIA_BASE=https://logs-testing.mysatcomla.com/agentes
ARIA_AGENT_ID=
ARIA_AGENT_KEY=

# ── Consola de agentes (/panel/agentes) ────────────────────────────────
# SON DOS COSAS DISTINTAS y hacen falta las dos:
#   GATE_KEY   pasa el proxy inverso de ARIA (nginx/Caddy cortan con 401 todo
#              /agentes/ salvo /health e /invoke). No identifica a nadie.
#   TENANT_KEY identifica, y acota el alcance al tenant de tranqi: con ella no
#              se pueden ver ni tocar los otros tenants (verificado contra
#              require_tenant_scope / assert_tenant_access de ARIA).
# El GATE_KEY de tranqi-web NO es el token de superadmin: es un segundo valor
# que el gate acepta, emitido solo para esta app.
ARIA_GATE_KEY=
ARIA_TENANT_KEY=

# ── Asistentes del panel, uno por perfil (TRQ-009) ─────────────────────
TRQ_CLIENTE_BASE=https://logs-testing.mysatcomla.com/agentes
TRQ_CLIENTE_AGENT_ID=
TRQ_CLIENTE_AGENT_KEY=
TRQ_ABOGADO_BASE=https://logs-testing.mysatcomla.com/agentes
TRQ_ABOGADO_AGENT_ID=
TRQ_ABOGADO_AGENT_KEY=

# ── Identidad del usuario ante las herramientas de los agentes ─────────
# La app firma con CAPSULA_SECRETO una capsula de 5 minutos con quien esta
# hablando; ARIA la inyecta en el header del MCP y el MCP la canjea, con
# SUPABASE_JWT_SECRET, por un token de usuario con el que consulta bajo RLS.
# El modelo nunca ve ninguno de los dos. Ver ADR-0005.
# SUPABASE_JWT_SECRET: Dashboard -> Project Settings -> API -> JWT Secret.
ASISTENTE_CAPSULA_SECRETO=
SUPABASE_JWT_SECRET=

# Proyecto Supabase "ecosistema" (oaybbpdxhlxjbpwnoymy) -- ver
# gobernanza/arquitectura/inventario-supabase.md. URL y publishable key son
# publicas por diseno (la seguridad real es RLS, no el secreto de esta clave).
NEXT_PUBLIC_SUPABASE_URL=https://auth.tranqi24.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vC-t-FcOQ2Q5_XkTCcPKdQ_bveIh5YS

# SMTP propio de tranqi (Zoho Mail, info@tranqi24.com) -- usado por
# @eco/notificaciones para el OTP de registro. Nunca NEXT_PUBLIC_*: server-only
# (ver gobernanza/politicas/gestion-credenciales.md §3).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@tranqi24.com
SMTP_PASS=
SMTP_FROM_NOMBRE=tranqi
