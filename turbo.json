{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "globalPassThroughEnv": [
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM_NOMBRE",
    "EMAIL_HOST",
    "EMAIL_PORT",
    "EMAIL_USER",
    "EMAIL_PASS",
    "CORREO_FUNCION_CLAVE",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_JWT_SECRET",
    "CRON_SECRET",
    "ARIA_BASE",
    "ARIA_AGENT_ID",
    "ARIA_AGENT_KEY",
    "ARIA_TENANT_KEY",
    "ARIA_GATE_KEY",
    "TRQ_CLIENTE_BASE",
    "TRQ_CLIENTE_AGENT_ID",
    "TRQ_CLIENTE_AGENT_KEY",
    "TRQ_ABOGADO_BASE",
    "TRQ_ABOGADO_AGENT_ID",
    "TRQ_ABOGADO_AGENT_KEY",
    "ASISTENTE_CAPSULA_SECRETO"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
